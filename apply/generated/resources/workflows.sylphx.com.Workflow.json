  "plural": "workflows",
  "priority_chunk": false,
  "reconciled": false,
  "service": "workflows",
  "shape": "spec_status",
  "singular": "workflow",
  "stale_bound": "300s",
  "storage": "kernel",
  "terraform": true,
  "type": "workflows.sylphx.com/Workflow"
}

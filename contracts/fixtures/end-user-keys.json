		},
		{
			"name": "access-grammar",
			"token": "sylphx_sk_live_abcd0000000000000000_AbCdEfGhIjKlMnOpQrStUvWxYz0123454AYnNL",
			"why": "a Sylphx credential is never an end-user key"

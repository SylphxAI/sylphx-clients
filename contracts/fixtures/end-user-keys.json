			"start": "kk_live_AbCd",
			"last4": "2345"
		},
		{
			"prefix": "kk",
			"mode": "test",
			"secret": "00000000000000000000000000000000",
			"checksum": "3LhdBU",
			"token": "kk_test_000000000000000000000000000000003LhdBU",

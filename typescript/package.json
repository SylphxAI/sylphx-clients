{
	"name": "@sylphx/sdk",
	"version": "0.30.0",
	"description": "The Sylphx SDK: one API, one key, every Sylphx service. Generated from the Sylphx schema registry.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SylphxAI/sylphx-js.git"
	},
	"homepage": "https://sylphx.com/docs",
	"keywords": [
		"sylphx",
		"sdk",
		"api",
		"cloud"
	],
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome check test",
		"test": "bun test",
		"prepublishOnly": "bun run build"
	},
	"devDependencies": {
		"@types/bun": "1.4.0",
		"typescript": "5.9.3"
	},
	"publishConfig": {
		"access": "public",
		"tag": "next"
	}
}

{
	"name": "@sylphx/sdk",
	"version": "0.32.14",
	"description": "The Sylphx SDK: one API, one key, every Sylphx service. Generated from the Sylphx schema registry.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SylphxAI/sylphx-clients.git",
		"directory": "typescript"
	},
	"homepage": "https://sylphx.com/docs",
	"keywords": [
		"sylphx",
		"sdk",
		"api",
		"cloud"
	],
	"engines": {
		"node": ">=20.19"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./sign-in": {
			"types": "./dist/sign-in.d.ts",
			"default": "./dist/sign-in.js"
		},
		"./sign-in.css": "./dist/sign-in.css"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/sign-in/sign-in.css dist/sign-in.css",
		"typecheck": "tsc --noEmit",
		"lint": "biome check test",
		"test": "bun test",
		"prepublishOnly": "bun run build"
	},
	"devDependencies": {
		"ajv": "8.20.0",
		"@types/bun": "1.4.0",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"@types/react": "^19",
		"react": "^19"
	},
	"publishConfig": {
		"access": "public",
		"tag": "next",
		"provenance": true
	},
	"sideEffects": [
		"**/*.css"
	],
	"peerDependencies": {
		"react": ">=18"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	}
}

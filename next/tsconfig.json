{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": false,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["bun"],
		"jsx": "react-jsx",
		"paths": {
			"@sylphx/next/auth": ["./src/auth.tsx"]
		}
	},
	"include": ["src/**/*", "test/**/*"]
}

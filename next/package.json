{
	"name": "@sylphx/next",
	"version": "0.2.11",
	"description": "Customer-branded App Router sign-in and shared Next.js ISR/use-cache handlers.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SylphxAI/sylphx-clients.git",
		"directory": "next"
	},
	"homepage": "https://sylphx.com/docs",
	"keywords": [
		"sylphx",
		"nextjs",
		"isr",
		"cache-handler"
	],
	"engines": {
		"node": ">=20.19"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./cache-handler": {
			"types": "./dist/cache-handler.d.ts",
			"default": "./dist/cache-handler.js"
		},
		"./use-cache-handler": {
			"types": "./dist/use-cache-handler.d.ts",
			"default": "./dist/use-cache-handler.js"
		},
		"./auth": {
			"types": "./dist/auth.d.ts",
			"default": "./dist/auth.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"@sylphx/sdk": ">=0.32.2",
		"next": ">=14.1.0",
		"redis": ">=5.0.0",
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0"
	},
	"peerDependenciesMeta": {
		"@sylphx/sdk": {
			"optional": true
		},
		"next": {
			"optional": true
		},
		"redis": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/bun": "1.4.0",
		"typescript": "5.9.3",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"next": "^15.5.28",
		"@sylphx/sdk": "0.32.13"
	},
	"publishConfig": {
		"access": "public",
		"tag": "next",
		"provenance": true
	}
}
